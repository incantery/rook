{
    "name": "rook",
    "description": "rook's ask: send a question to the phone through rook's relay, and collect the answer",
    "version": "0.1.0",
    "author": {"name": "incantery"},
    "mcpServers": {
        "rook": {
            "type": "stdio",
            "command": "rookctl",
            "args": ["mcp"],
            "timeout": 1800000
        }
    }
}
