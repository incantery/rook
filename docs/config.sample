# rook config — the LEGACY flat format. Still read, no longer canonical:
# the TOML format (config.sample.toml → ~/.config/rook/config.toml) is the
# documented surface now, and when config.toml exists this file is ignored
# entirely. New keys (the [editor] scope, per-mode keybinds) are TOML-only.
#
# Copy this to ~/.config/rook/config (XDG_CONFIG_HOME is respected) and
# uncomment what you want to change. Every key below is set to its actual
# default and commented out, so dropping this file in verbatim is a no-op.
#
# Format is ghostty-style: one `key = value` per line, `#` starts a comment,
# blank lines are ignored. Unknown keys are ignored too, so a newer sample
# than your build degrades quietly. The file is re-read on every page reload —
# no restart needed to pick up an edit.
#
# Secrets are NOT managed here (see the bottom of this file).


# ── Fonts and window chrome ──────────────────────────────────────────────

# Terminal font. A Nerd Font gives you the powerline/devicon glyphs.
# font-family = Hack Nerd Font Mono

# Point size.
# font-size = 18

# Window background opacity, 0 (transparent) to 1 (opaque).
# background-opacity = 0.95

# Color theme (built-in). One of: Material Ocean (default), One Dark, One Light.
# theme = Material Ocean

# Inner padding between the terminal grid and the window edge, in points.
# window-padding-x = 4
# window-padding-y = 4


# ── Built-in agent (opt-in; see docs/agent.md) ───────────────────────────

# The whole agent feature is off until you turn it on. Accepts on or true.
# agent = off

# Which model backend the drafter runs on.
#   auto    prefer claude when it's on PATH, else an OpenAI key (default)
#   claude  shell out to the coder CLI you already have. No API key, no
#           setup: rook already needs claude to have anything to watch.
#           Costs the drafter your subscription's rate limit alongside
#           your coding sessions.
#   openai  an API key (rookctl set-openai-key). Keeps the drafter's
#           spend off your subscription — two tiers, two billing models.
# Either way the drafter only ever proposes; you send.
# agent-engine = auto

# Model the drafter runs. Empty means the engine's own default: haiku for
# claude, gpt-5.4-nano for openai.
# agent-model =

# Hard daily spend ceiling for the agent, in US dollars. Note that on the
# claude engine with a subscription, spend is what the calls WOULD have
# cost via the API — the cap reads as a rate limiter, not a bill.
# agent-daily-cap-usd = 1.00


# ── Coder ────────────────────────────────────────────────────────────────

# The CLI the host types into spawned task windows (spawn drafts, the
# conflict-resolve chip, workflow stages).
# coder = claude


# ── Jira issue queue (host-read) ─────────────────────────────────────────
#
# jira-url and jira-email are global. A workspace opts into the queue with a
# per-workspace jira-project key (below). The API token is NOT set here — it
# lives in the keychain (see the secrets note at the bottom). Empty by
# default, which leaves the queue off.

# Your Jira site.
# jira-url = https://your-org.atlassian.net

# The account email the token belongs to.
# jira-email = you@example.com

# Overrides the default issue query. Left empty, rook uses its built-in JQL.
# jira-jql = assignee = currentUser() AND statusCategory != Done ORDER BY updated DESC


# ── Workflow: staged review pipeline (host-read) ─────────────────────────
#
# Slash commands, comma-separated, run in sequence after a worktree's coding
# agent opens its PR — each spawned in its own window. Empty means the
# feature is off.
# workflow = /security-review, /review


# ── Language servers (plugins, host-managed) ─────────────────────────────
#
# The plugin intent tier: language names, comma-separated, expanded through
# rook's curated catalog (go, typescript, svelte). Rook installs and manages
# these servers itself under ~/.local/share/rook/plugins — pinned versions,
# lazy install on first use, nothing touches your global environment. Empty
# means no language support.
# lsp =

# The explicit tier addresses one server by name. A command line brings your
# own server: rook execs it from PATH as found and never installs or
# upgrades it. `off` disables a server either tier declared.
# lsp-<server> = zls

# Which file extensions route to the server, comma-separated.
# lsp-<server>-filetypes = zig

# Root markers, in order: the nearest ancestor directory containing one keys
# the server instance (a monorepo's Go module and TS app each get their
# own). No marker found means the workspace root.
# lsp-<server>-roots = build.zig, .git

# Raw JSON handed to the server verbatim (workspace/didChangeConfiguration);
# rook never interprets it. Replaces the catalog entry's default wholesale.
# Key it by the SECTION the server pulls — gopls asks for "gopls", so a flat
# {"staticcheck":true} is answered with null and quietly does nothing.
# Note the catalog default for gopls is {"gopls":{"semanticTokens":true}},
# which turns on the semantic highlighting layer; overriding this key drops
# that unless you carry it along.
# lsp-<server>-settings = {"gopls":{"staticcheck":true,"semanticTokens":true}}
#
# A repository may check in `<repo>/.rook/config` with lsp* keys only: it is
# parsed after this file (its lines win) and may select catalog languages or
# tune declared servers — but its command lines are refused, so a cloned
# repo can never make rook exec something. Refusals show in lsp status.


# ── Workspace visibility filter (presentation-only) ───────────────────────
#
# A comma-separated list of workspace names to show in the dashboard, mission
# control, and /overview. When set, only these workspaces (and any worktree
# carved from one of them) appear — all others are filtered out. Useful for
# demos and screenshots. Not access control: registration and per-workspace
# endpoints are unaffected. Unset means every workspace shows.
# For example: workspace-allow = rook, dora


# ── Keybindings ──────────────────────────────────────────────────────────

# The leader: the tmux-style prefix that arms the bare-key bindings below.
# Either a single key (the backtick default) or a modifier chord in the same
# form as a keybind trigger — set it to ctrl+b for the tmux default. Press it
# twice to pass it through to the terminal.
# leader = `

# keybind = <trigger>=<command>, one line per binding, repeatable. A bare key
# ("m") fires after the backtick prefix; a modifier chord ("cmd+shift+k")
# fires directly. An empty command ("keybind = m=") unbinds a default. The
# frontend owns validation and fails open, so unknown commands, unparseable
# chords, and reserved triggers (digits, the backtick escape) are ignored.
# keybind = m=workspace.manager
# keybind = cmd+shift+k=palette.toggle

# ctrl+h/j/k/l move between panes, vim-tmux-navigator style, and cross into an
# open side pane at the layout's edge. A full-screen app keeps them — while
# vim, less or htop is up they go to the app, not to rook — but at a SHELL
# PROMPT rook takes them, so ctrl+l no longer clears the screen and ctrl+h no
# longer backspaces. Unbind either to take it back (` and the arrows still
# navigate, in vim too):
# keybind = ctrl+l=
# keybind = ctrl+h=


# ── Per-workspace overrides (dynamic keys) ───────────────────────────────
#
# These keys carry a workspace name in the key itself. Replace <workspace>
# with the workspace's name. They have no global default — a workspace simply
# has no override until you add its line.

# Opt a workspace into the Jira queue by naming its project key. Both parts
# matter: the <workspace> suffix picks the workspace, the value is the Jira
# project key. No line means that workspace pulls no Jira issues.
# jira-project-<workspace> = KEY

# The worktree-branch prefix for a workspace. The value is used verbatim, so
# bring your own trailing separator. Unset falls back to rook/. An explicitly
# empty value (nothing after the =) means no prefix at all, so branches match a
# CI naming scheme exactly — issue FIX-123 "fix the drop down spacing" then
# lands on branch FIX-123-fix-the-drop-down-spacing.
# branch-prefix-<workspace> = seth/
# branch-prefix-<workspace> =

# What joins a spawning issue's key to its title in that branch. Defaults to a
# hyphen — issue FOO-123 "bar baz" lands on rook/FOO-123-bar-baz — so set this
# to / for the scheme that reads rook/FOO-123/bar-baz. Branch names only: the
# workspace is a directory too, and stays FOO-123-bar-baz either way.
# branch-delimiter-<workspace> = /

# Override the global workflow for one workspace. An explicitly empty value
# (nothing after the =) opts that workspace out of the global pipeline
# entirely; a non-empty value replaces it for that workspace.
# workflow-<workspace> = /review


# ── Secrets are NOT file-managed ─────────────────────────────────────────
#
# The OpenAI key (the agent's credential) and the Jira API token never live
# in this file — the config stays user-owned and safe to commit or share.
# They live in the login keychain instead:
#
#   rookctl set-jira-token        # stores the Jira API token
#
# The OpenAI key is set from the app. Each has a file fallback for
# headless setups, and both must be tight 0600:
#
#   ~/.config/rook/openai-key
#   ~/.config/rook/jira-token
