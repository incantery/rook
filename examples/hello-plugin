#!/bin/sh
# rook-hello — the plugin you install to check that plugins work.
#
# It answers rook's two questions and nothing else: what are you (describe),
# and what have you got (items.list). The answer is fixed, so what shows up
# in the panel does not depend on the machine, the network, or the clock —
# if this renders, the plugin machinery is working.
#
# Install:
#   curl -fsSL https://raw.githubusercontent.com/incantery/rook/main/examples/hello-plugin \
#     -o ~/.config/rook/plugins/hello && chmod +x ~/.config/rook/plugins/hello

while IFS= read -r line; do
  id=`expr "$line" : '.*"id":\([0-9]*\)'`
  case "$line" in
    *'"op":"describe"'*)
      printf '{"v":1,"id":%s,"ok":true,"result":{"name":"hello","version":"1.0.0","capabilities":["items.list"],"surfaces":["LIST"]}}\n' "$id"
      ;;
    *'"op":"items.list"'*)
      printf '{"v":1,"id":%s,"ok":true,"result":{"items":[' "$id"
      printf '{"id":"1","title":"hello, world","state":"ok","subtitle":"this plugin is running"},'
      printf '{"id":"2","title":"a second item","state":"running","fields":[{"key":"count","kind":"NUMBER","value":"42"}]},'
      printf '{"id":"3","title":"and a third","state":"blocked"}'
      printf ']}}\n'
      ;;
    *)
      printf '{"v":1,"id":%s,"ok":false,"error":"hello only does items.list"}\n' "$id"
      ;;
  esac
done
