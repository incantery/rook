{
    "name": "frontend",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "packageManager": "pnpm@9.10.0",
    "scripts": {
        "dev": "vite",
        "build:dev": "vite build --minify false --mode development",
        "build": "vite build --mode production",
        "preview": "vite preview",
        "test": "vitest run",
        "test:bench": "playwright test -c playwright.bench.config.ts",
        "check": "svelte-check",
        "lint": "oxlint --deny-warnings && node scripts/lint-theme.mjs",
        "format": "oxfmt .",
        "format:check": "oxfmt --check .",
        "grammars": "node scripts/vendor-grammars.mjs"
    },
    "dependencies": {
        "@wailsio/runtime": "latest",
        "@xterm/addon-fit": "^0.11.0",
        "@xterm/addon-webgl": "^0.19.0",
        "@xterm/xterm": "^6.0.0",
        "monaco-editor": "0.55.1",
        "monaco-vim": "0.4.4",
        "vscode-oniguruma": "2.0.1",
        "vscode-textmate": "9.3.2"
    },
    "devDependencies": {
        "@playwright/test": "^1.61.1",
        "@sveltejs/vite-plugin-svelte": "^7.2.0",
        "@tailwindcss/vite": "^4.3.2",
        "oxfmt": "^0.58.0",
        "oxlint": "^1.73.0",
        "svelte": "^5.56.4",
        "svelte-check": "^4.7.2",
        "tailwindcss": "^4.3.2",
        "tm-grammars": "1.31.15",
        "typescript": "^5.9.3",
        "vite": "^8.0.5",
        "vitest": "^4.1.10"
    }
}
